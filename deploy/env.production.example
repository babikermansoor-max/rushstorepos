# Copy to /opt/rushstore/.env.production on the server and fill in.
# Values come from /opt/supabase/docker/.env of your self-hosted stack.

# Public (browser) settings
VITE_SUPABASE_URL=https://api.rushstorepos.com
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
VITE_SUPABASE_PROJECT_ID=self-hosted

# Server-only settings (never share)
SUPABASE_URL=https://api.rushstorepos.com
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
